{
  "name": "daod",
  "version": "3.0.0",
  "description": "An AI maths tutor that talks while it draws on a glass board in 3D — and lets you interrupt.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "dev": "DAOD_DEV=1 node --watch server/server.mjs",
    "start": "node server/server.mjs",
    "demo": "DAOD_DEMO=1 DAOD_DEV=1 node server/server.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc -p jsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
