# ── DAOD configuration ───────────────────────────────────────────────────────
# Copy to .env and fill in. With no key at all, DAOD runs in demo mode.

# Groq (https://console.groq.com/keys) — used for the lesson stream, and for the
# optional natural voice (Orpheus) and Whisper speech-to-text.
GROQ_API_KEY=

# Model. gpt-oss-120b is the default (fast + strong maths). Alternatives on Groq:
#   openai/gpt-oss-20b         ~2x faster, slightly weaker
#   llama-3.3-70b-versatile    no reasoning step, very quick first token
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low

# Any OpenAI-compatible server works, e.g. open-source models locally:
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:14b   LLM_API_KEY=ollama
#   LM Studio:  LLM_BASE_URL=http://localhost:1234/v1
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-3.5-flash   LLM_API_KEY=...
#   Cerebras / OpenRouter / Together: their /v1 URL + key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=

# Speech (defaults to Groq with GROQ_API_KEY)
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=autumn
# STT_MODEL=whisper-large-v3-turbo

# PORT=8787
